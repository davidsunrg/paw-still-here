{
  "name": "@paw/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface Env",
    "db:migrate:local": "wrangler d1 migrations apply paw-still-here --local"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "@paw/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260213.0",
    "@types/node": "^24.7.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}