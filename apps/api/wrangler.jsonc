{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paw-still-here-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paw",
      "database_id": "5c4e6ed9-d9de-45b0-a55a-fa2d4c23116a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "paw-public",
      "remote": true
    }
  ],
   "kv_namespaces": [
    {
      "binding": "CACHE_PAW",
      "id": "d319daa0823643a7948b4da6b7cfb599"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "PUBLIC_ASSETS_URL": "https://pub-2723f81c48814ceebac2839639b5b997.r2.dev"
  }
}